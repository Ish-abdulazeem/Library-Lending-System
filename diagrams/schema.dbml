Table books{
  book_id int [pk, increment]
  title varchar(100) [not null]
  publication_year int
  isbn varchar [unique, null]
}

Table copies{
  copy_id int [pk, increment]
  book_id int [not null, ref: > books.book_id]
  status varchar(20) [not null]
}

Table authors{
  author_id int [pk, increment]
  author_name varchar(200) [not null]
  nationality varchar(20)
}

Table book_authors{
  book_id int [not null, ref: > books.book_id]
  author_id int [not null, ref: > authors.author_id]

  indexes {
    (book_id, author_id) [pk]
  }
}

Table members{
  member_id int [pk, increment]
  first_name varchar(50) [not null]
  last_name varchar(50) [not null]
  phone_number varchar(20) [not null]
  email varchar(50) [unique]
  registration_date date [default: `now()`, not null]
  membership_status varchar(30) [not null]
}

Table loans{
  loan_id int [pk, increment]
  copy_id int [not null, ref: > copies.copy_id]
  member_id int [not null, ref: > members.member_id]
  borrowed_date date [default: `now()`, not null]
  due_date date [not null]
  return_date date
}
